# Synthetic 1000-species kinetic network (Antimony)
# Generated deterministically; benchmark/test model, NOT a biological reconstruction.
# Species: 1000 (S0000..S0999); reactions: 3400.
# Backbone cycle: 1000 reactions (250 reversible MM, 250 reversible mass-action,
#   250 irreversible MM, 250 irreversible MM with competitive inhibition).
# Additional crosslinks: 400 reversible reactions (200 MM, 200 mass-action).
#   Of the 200 crosslink MM reactions, 100 are Hill-activated by a third species.
# Exchange: 1000 constant inflows + 1000 first-order outflows.
# Reversible reactions use -> with a signed net flux; irreversible use =>.
# At S0000=...=S0999=1, steady-state residual is ~0; each backbone
# reaction carries a net cycle flux of 0.02, crosslinks carry zero net flux.
# Each species has balanced inflow and outflow at that reference state.
# Initial concentrations are perturbed away from the reference state.
# No biological units or experimental calibration implied.

model SyntheticKinetics1000()
  # ---- Main cyclic backbone ---------------------------------------------
  R0000: S0000 -> S0001; (Vf_R0000*(S0000/Kf_R0000) - Vr_R0000*(S0001/Kr_R0000))/(1 + S0000/Kf_R0000 + S0001/Kr_R0000);
  R0001: S0001 -> S0002; kf_R0001*S0001 - kr_R0001*S0002;
  R0002: S0002 => S0003; Vm_R0002*S0002/(Km_R0002 + S0002);
  R0003: S0003 => S0004; Vm_R0003*S0003/(Km_R0003*(1 + S0034/Ki_R0003) + S0003);
